---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import biliData from "@/data/bilibili.json";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;

const { user, stats, videos } = biliData;

const fmtNum = (n: number) => {
	if (n >= 10000) return `${(n / 10000).toFixed(1)}万`;
	return String(n);
};

const latestVideos = videos.slice(0, 2);
---

<WidgetLayout
	id="bilibili-card"
	name="我的B站"
	showTitle={showTitle}
	class={className}
	style={style}
>
  <div class="flex items-center gap-3">
    <img
      src={user.face}
      alt={user.name}
      referrerpolicy="no-referrer"
      loading="lazy"
      class="h-12 w-12 shrink-0 rounded-full object-cover ring-2 ring-(--primary)/20"
    />
    <div class="min-w-0 flex-1">
      <div class="truncate text-sm font-medium text-neutral-900 dark:text-neutral-100">
        {user.name}
      </div>
      <div class="mt-0.5 flex flex-wrap items-center gap-x-2 text-xs text-(--content-meta)">
        <span>{fmtNum(user.fans)} 粉丝</span>
        <span>·</span>
        <span>{fmtNum(stats.totalPlay)} 播放</span>
      </div>
    </div>
  </div>

  {
    latestVideos.length > 0 && (
      <div class="mt-3 grid grid-cols-2 gap-2">
        {latestVideos.map((video) => (
          <a
            href={video.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group"
          >
            <div class="relative aspect-video overflow-hidden rounded-lg bg-(--btn-regular-bg)">
              <img
                src={video.cover}
                alt={video.title}
                referrerpolicy="no-referrer"
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
              <span class="absolute right-1 bottom-1 rounded bg-black/70 px-1 text-[10px] text-white">
                {video.duration}
              </span>
            </div>
            <p class="mt-1 line-clamp-1 text-xs text-neutral-700 transition-colors group-hover:text-(--primary) dark:text-neutral-300">
              {video.title}
            </p>
          </a>
        ))}
      </div>
    )
  }

  <a
    href="/bilibili/"
    class="mt-3 flex items-center justify-center gap-1.5 rounded-lg bg-(--btn-regular-bg) py-2 text-sm text-neutral-800 transition hover:opacity-80 dark:text-neutral-200"
  >
    <Icon name="material-symbols:smart-display" class="text-[1.1rem]" />
    查看我的B站主页
  </a>
</WidgetLayout>
