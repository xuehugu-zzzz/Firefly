---
/**
 * 成绩曲线（纯 SVG，无第三方依赖）
 *
 * 用法：
 *   <GradeChart
 *     title="总分"
 *     unit="分"
 *     data={[{ label: "高二下期末", value: 468 }, { label: "高三定位考", value: 521 }]}
 *   />
 *
 * invert = true 用于「排名」这类越小越好的指标（名次越小，点越高）。
 */
interface DataPoint {
	label: string;
	value: number;
}

interface Props {
	title?: string;
	subtitle?: string;
	data: DataPoint[];
	unit?: string;
	invert?: boolean;
	height?: number;
}

const {
	title,
	subtitle,
	data,
	unit = "",
	invert = false,
	height = 240,
} = Astro.props;

const W = 640;
const H = height;
const PAD = { l: 48, r: 24, t: 30, b: 42 };
const plotW = W - PAD.l - PAD.r;
const plotH = H - PAD.t - PAD.b;

const vals = data.map((d) => d.value);
const rawMin = Math.min(...vals);
const rawMax = Math.max(...vals);
const span = rawMax - rawMin || Math.max(1, Math.abs(rawMax) * 0.1);
const lo = rawMin - span * 0.2;
const hi = rawMax + span * 0.2;

const xFor = (i: number) =>
	data.length === 1 ? PAD.l + plotW / 2 : PAD.l + (plotW * i) / (data.length - 1);

const yFor = (v: number) => {
	const t = (v - lo) / (hi - lo);
	return PAD.t + plotH * (invert ? t : 1 - t);
};

const pts = data.map((d, i) => [xFor(i), yFor(d.value)] as const);
const linePath = pts
	.map((p, i) => `${i === 0 ? "M" : "L"}${p[0].toFixed(1)} ${p[1].toFixed(1)}`)
	.join(" ");
const baseY = PAD.t + plotH;
const areaPath =
	pts.length > 1
		? `${linePath} L${pts[pts.length - 1][0].toFixed(1)} ${baseY} L${pts[0][0].toFixed(1)} ${baseY} Z`
		: "";

const gridVals = [0, 0.5, 1].map((k) => lo + (hi - lo) * k);
const fmt = (n: number) =>
	Number.isInteger(n) ? String(n) : n.toFixed(1);
---

<div class="card-base px-6 py-5">
	{
		title && (
			<div class="mb-1 flex items-baseline gap-2">
				<h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">
					{title}
				</h3>
				{subtitle && (
					<span class="text-xs text-(--content-meta)">{subtitle}</span>
				)}
			</div>
		)
	}

	<svg
		viewBox={`0 0 ${W} ${H}`}
		class="h-auto w-full"
		role="img"
		aria-label={title ?? "成绩曲线"}
	>
		<!-- 横向网格 -->
		{
			gridVals.map((v) => (
				<g>
					<line
						x1={PAD.l}
						x2={W - PAD.r}
						y1={yFor(v)}
						y2={yFor(v)}
						stroke="var(--content-meta)"
						stroke-opacity="0.18"
						stroke-dasharray="4 5"
					/>
					<text
						x={PAD.l - 8}
						y={yFor(v) + 4}
						text-anchor="end"
						font-size="11"
						fill="var(--content-meta)"
						opacity="0.75"
					>
						{fmt(Math.round(v * 10) / 10)}
					</text>
				</g>
			))
		}

		<!-- 面积 + 折线 -->
		{areaPath && <path d={areaPath} fill="var(--primary)" fill-opacity="0.10" />}
		{
			linePath && (
				<path
					d={linePath}
					fill="none"
					stroke="var(--primary)"
					stroke-width="2.5"
					stroke-linejoin="round"
					stroke-linecap="round"
				/>
			)
		}

		<!-- 数据点 -->
		{
			pts.map((p, i) => (
				<g>
					<circle
						cx={p[0]}
						cy={p[1]}
						r="9"
						fill="var(--primary)"
						fill-opacity="0.15"
					/>
					<circle cx={p[0]} cy={p[1]} r="4.5" fill="var(--primary)" />
					<text
						x={p[0]}
						y={p[1] - 14}
						text-anchor="middle"
						font-size="12.5"
						font-weight="700"
						fill="var(--primary)"
					>
						{data[i].value}
						{unit}
					</text>
					<text
						x={p[0]}
						y={H - 14}
						text-anchor="middle"
						font-size="11"
						fill="var(--content-meta)"
					>
						{data[i].label}
					</text>
				</g>
			))
		}
	</svg>
</div>
