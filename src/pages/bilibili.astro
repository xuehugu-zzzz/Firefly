---
import { Icon } from "astro-icon/components";
import biliData from "@/data/bilibili.json";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "我的B站";
const description = "我在 B 站的投稿视频、数据与公开收藏夹，自动更新。";

const { user, stats, videos, fetchedAt, favorites } = biliData;

const FAV_PREVIEW = 6;

const fmtNum = (n: number) => {
	if (n >= 100000000) return `${(n / 100000000).toFixed(1)}亿`;
	if (n >= 10000) return `${(n / 10000).toFixed(1)}万`;
	return String(n);
};

const dateFmt = new Intl.DateTimeFormat("zh-CN", {
	timeZone: "Asia/Shanghai",
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
});
const timeFmt = new Intl.DateTimeFormat("zh-CN", {
	timeZone: "Asia/Shanghai",
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
	hour: "2-digit",
	minute: "2-digit",
	hour12: false,
});

const fmtDate = (iso: string | null) =>
	iso ? dateFmt.format(new Date(iso)).replace(/\//g, "-") : "";
const fmtDateTime = (iso: string) =>
	timeFmt.format(new Date(iso)).replace(/\//g, "-");

const favTotal = favorites.reduce((sum, f) => sum + f.mediaCount, 0);

const statItems = [
	{
		label: "粉丝",
		value: fmtNum(user.fans),
		icon: "material-symbols:group-rounded",
	},
	{
		label: "关注",
		value: fmtNum(user.following),
		icon: "material-symbols:person-add-rounded",
	},
	{
		label: "投稿",
		value: fmtNum(stats.videoCount),
		icon: "material-symbols:video-library-rounded",
	},
	{
		label: "总播放",
		value: fmtNum(stats.totalPlay),
		icon: "material-symbols:play-circle-rounded",
	},
];
---

<MainGridLayout title={title} description={description}>
  <div class="flex flex-col gap-4">
    <!-- 个人信息卡片 -->
    <div class="card-base px-6 py-6 relative overflow-hidden">
      <div
        class="pointer-events-none absolute -top-16 -right-16 h-48 w-48 rounded-full bg-(--primary)/10 blur-2xl"
      >
      </div>

      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5">
        <img
          src={user.face}
          alt={user.name}
          referrerpolicy="no-referrer"
          loading="lazy"
          class="h-24 w-24 shrink-0 rounded-full object-cover ring-4 ring-(--primary)/20"
        />
        <div class="flex-1 text-center sm:text-left">
          <div class="flex items-center justify-center sm:justify-start gap-2">
            <h1
              class="text-2xl font-bold text-neutral-900 dark:text-neutral-100"
            >
              {user.name}
            </h1>
            <span
              class="rounded-full bg-(--primary)/10 px-2 py-0.5 text-xs text-(--primary)"
              >UP 主</span
            >
          </div>
          <p class="mt-1 text-sm text-(--content-meta)">
            UID {user.uid}{user.sign ? ` · ${user.sign}` : ""}
          </p>
          <a
            href={user.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-(--btn-regular-bg) px-4 py-1.5 text-sm transition hover:opacity-80"
          >
            <Icon
              name="material-symbols:open-in-new-rounded"
              class="text-[1.1rem]"
            />
            去 B 站看我
          </a>
        </div>
      </div>

      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {
          statItems.map((item) => (
            <div class="rounded-(--radius-large) bg-(--btn-regular-bg) px-4 py-3">
              <div class="flex items-center gap-1.5 text-xs text-(--content-meta)">
                <Icon name={item.icon} class="text-[1rem]" />
                {item.label}
              </div>
              <div class="mt-1 text-xl font-bold text-neutral-900 dark:text-neutral-100">
                {item.value}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- 投稿视频 -->
    <div class="card-base px-6 py-6">
      <div class="mb-4 flex items-center gap-2">
        <Icon
          name="material-symbols:smart-display-rounded"
          class="text-[1.4rem] text-(--primary)"
        />
        <h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-100">
          我的投稿
        </h2>
        <span class="text-sm text-(--content-meta)">共 {videos.length} 个视频</span>
      </div>

      {
        videos.length === 0 ? (
          <p class="py-8 text-center text-sm text-(--content-meta)">
            还没有投稿视频，敬请期待～
          </p>
        ) : (
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {videos.map((video) => (
              <a
                href={video.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group overflow-hidden rounded-(--radius-large) border border-(--line-divider) transition hover:shadow-lg"
              >
                <div class="relative aspect-video overflow-hidden bg-(--btn-regular-bg)">
                  <img
                    src={video.cover}
                    alt={video.title}
                    referrerpolicy="no-referrer"
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                  <span class="absolute right-2 bottom-2 rounded bg-black/70 px-1.5 py-0.5 text-[11px] text-white">
                    {video.duration}
                  </span>
                  <span class="absolute bottom-2 left-2 flex items-center gap-0.5 rounded bg-black/70 px-1.5 py-0.5 text-[11px] text-white">
                    <Icon
                      name="material-symbols:play-arrow-rounded"
                      class="text-[0.9rem]"
                    />
                    {fmtNum(video.play)}
                  </span>
                </div>
                <div class="p-3">
                  <h3 class="line-clamp-2 text-sm leading-snug font-medium text-neutral-900 transition-colors group-hover:text-(--primary) dark:text-neutral-100">
                    {video.title}
                  </h3>
                  <div class="mt-2 flex items-center gap-3 text-xs text-(--content-meta)">
                    <span>{fmtDate(video.created)}</span>
                    <span>弹幕 {video.danmaku}</span>
                    <span>评论 {video.comment}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>

    <!-- 公开收藏夹 -->
    {
      favorites.length > 0 && (
        <div class="card-base px-6 py-6">
          <div class="mb-5 flex flex-wrap items-center gap-2">
            <Icon
              name="material-symbols:star-rounded"
              class="text-[1.4rem] text-(--primary)"
            />
            <h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-100">
              我的收藏
            </h2>
            <span class="text-sm text-(--content-meta)">
              {favorites.length} 个收藏夹 · 共 {favTotal} 个视频
            </span>
          </div>

          <div class="flex flex-col gap-7">
            {favorites.map((fav) => (
              <section data-fav-section>
                <div class="mb-3 flex items-center justify-between gap-3">
                  <div class="flex min-w-0 items-center gap-2">
                    <h3 class="truncate text-base font-semibold text-neutral-900 dark:text-neutral-100">
                      {fav.title}
                    </h3>
                    <span class="shrink-0 text-xs text-(--content-meta)">
                      {fav.mediaCount} 个视频
                    </span>
                  </div>
                  <a
                    href={fav.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex shrink-0 items-center gap-0.5 text-xs text-(--primary) hover:underline"
                  >
                    在 B 站查看
                    <Icon
                      name="material-symbols:open-in-new-rounded"
                      class="text-[0.9rem]"
                    />
                  </a>
                </div>

                <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                  {fav.medias.map((media, idx) => (
                    <a
                      href={media.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-fav-item={fav.id}
                      data-fav-idx={idx}
                      class:list={["group", idx >= FAV_PREVIEW && "hidden"]}
                    >
                      <div class="relative aspect-video overflow-hidden rounded-lg bg-(--btn-regular-bg)">
                        <img
                          src={media.cover}
                          alt={media.title}
                          referrerpolicy="no-referrer"
                          loading="lazy"
                          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                        />
                        <span class="absolute right-1.5 bottom-1.5 rounded bg-black/70 px-1 text-[10px] text-white">
                          {media.duration}
                        </span>
                      </div>
                      <p class="mt-1.5 line-clamp-2 text-xs leading-snug text-neutral-800 transition-colors group-hover:text-(--primary) dark:text-neutral-200">
                        {media.title}
                      </p>
                    </a>
                  ))}
                </div>

                {fav.medias.length > FAV_PREVIEW && (
                  <button
                    type="button"
                    data-fav-toggle={fav.id}
                    data-fav-total={fav.medias.length}
                    data-expanded="false"
                    class="mt-3 w-full rounded-lg bg-(--btn-regular-bg) py-2 text-xs text-neutral-700 transition hover:opacity-80 dark:text-neutral-300"
                  >
                    <span>展开全部 {fav.medias.length} 个</span>
                  </button>
                )}

                {fav.mediaCount > fav.medias.length && (
                  <p class="mt-2 text-xs text-(--content-meta)">
                    这里只显示最近收藏的 {fav.medias.length} 个，完整 {fav.mediaCount}{" "}
                    个请点「在 B 站查看」
                  </p>
                )}
              </section>
            ))}
          </div>
        </div>
      )
    }

    <!-- 数据来源说明 -->
    <div class="px-2 pb-2 text-center text-xs text-(--content-meta)">
      <p>
        数据来自 B 站公开接口，更新于 {fmtDateTime(fetchedAt)}，自动定时刷新
      </p>
    </div>
  </div>
</MainGridLayout>

<script>
  const PREVIEW = 6;

  document.querySelectorAll("[data-fav-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.getAttribute("data-fav-toggle");
      const section = btn.closest("[data-fav-section]");
      if (!id || !section) return;

      const willExpand = btn.getAttribute("data-expanded") !== "true";
      section.querySelectorAll('[data-fav-item="' + id + '"]').forEach((item) => {
        if (Number(item.getAttribute("data-fav-idx")) >= PREVIEW) {
          item.classList.toggle("hidden", !willExpand);
        }
      });

      btn.setAttribute("data-expanded", String(willExpand));
      const label = btn.querySelector("span");
      if (label) {
        const total = btn.getAttribute("data-fav-total");
        label.textContent = willExpand ? "收起" : "展开全部 " + total + " 个";
      }
    });
  });
</script>
